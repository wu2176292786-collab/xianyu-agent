{
  "manifest_version": 3,
  "name": "闲鱼选品研究采集端",
  "version": "1.1.1",
  "description": "在闲鱼页面上点一下，把搜索页按应用里设定的页数连翻（真点「下一页」）或当前商详投进本机的「选品研究」。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.goofish.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "加入研究"
  },
  "content_scripts": [
    {
      "matches": ["https://*.goofish.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.goofish.com/*"],
      "js": ["collect.js"],
      "run_at": "document_idle"
    }
  ]
}
